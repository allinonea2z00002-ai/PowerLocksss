<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the app see all launcher apps (Android 11+ hides them otherwise),
         and every app that can open a web link — the browser set for URL
         detection is discovered at runtime, so any installed browser is
         covered, not just a fixed list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/powerlock2_icon"
        android:roundIcon="@mipmap/powerlock2_icon"
        android:label="PowerLock 2"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Build 138 (user 2026-11-28 18:20): NO launcher icon at all,
             ever. The user does not need the icon and wants the app hidden
             so it cannot be uninstalled from the launcher. The alias is
             disabled in the manifest by default AND Store.syncLauncherIcon
             now always disables it (it never re-enables it, lock or no
             lock). The old lock-gated hide (builds 132–135) never worked
             on this Vivo + Smart Launcher: Diagnostics said
             "icon: hidden" but the drawer still showed it. MainActivity
             itself stays enabled, so the dialer secret code
             (\*#\*#1#\*#\*) can still launch it via an explicit intent,
             as can the KeepAlive notification and the secret-shape
             window (build 137). If the LAUNCHER filter stayed on
             MainActivity, disabling it would also block the explicit
             launch. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/powerlock2_icon"
            android:roundIcon="@mipmap/powerlock2_icon"
            android:label="PowerLock 2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Build 132: dial \*#\*#1#\*#\* in the phone dialer to open
             PowerLock 2 even while its launcher icon is hidden during a
             lock. The dialer broadcasts SECRET_CODE; this receiver
             launches MainActivity. -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="1" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Build 137: the secret-shape window. The notification opens it
             during a lock; drawing the secret shape shows the PowerLock
             icon in our own view (no launcher popup, no Uninstall option).
             Kept out of Recents so the pad does not linger there. -->
        <activity
            android:name=".SecretWindowActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".BlocklistActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".KeywordListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".PowerBlockService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/service_config" />
        </service>

        <!-- Keep-alive: type dataSync (not location). Android 14+ throws a
             SecurityException starting a location-type foreground service
             when the location permission is not granted (or only granted
             "while using the app"), so the service silently never went
             foreground — then Vivo killed it on a Recents swipe and the
             whole process (including the AccessibilityService) died, which
             Android shows as "This service is malfunctioning". dataSync
             needs no runtime permission, so startForeground can never fail
             this way and the service reliably stays foreground. The location
             checks (PlaceWatcher) still run — they use the location
             permission, not the foreground-service type. -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
        </service>

        <!-- Site block: DNS-only VPN (no default route — it only answers DNS queries). -->
        <service
            android:name=".SiteBlockService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="site_block_dns" />
        </service>

        <!-- Uninstall block: while this admin is active, Android refuses to uninstall the app. -->
        <receiver
            android:name=".DeviceAdmin"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ScheduleReceiver"
            android:exported="false" />

        <receiver
            android:name=".MorningReceiver"
            android:exported="false" />

        <!-- Time capsule: fires when a sealed capsule reaches its open date. -->
        <receiver
            android:name=".CapsuleReceiver"
            android:exported="false" />

        <!-- Shares the focus-card image (cache dir only) with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.powerlock.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".LockWidget"
            android:exported="true"
            android:label="PowerLock 2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_widget_info" />
        </receiver>

    </application>
</manifest>
